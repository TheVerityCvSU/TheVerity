{
  "name": "the-verity",
  "productName": "The Verity",
  "version": "1.0.0",
  "description": "The Verity - Secure Examination & LMS Platform",
  "author": "The Verity Team",
  "private": true,
  "main": "electron/main.cjs",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "clean": "node clean.js",
    "clean:users": "node clean.js users",
    "clean:admin": "node clean.js admin",
    "start": "node server/server.js",
    "server": "node --watch server/server.js",
    "dev": "concurrently \"cd frontend && vite\" \"node --watch server/server.js\"",
    "build": "npm --prefix frontend run build",
    "build:server": "esbuild server/server.js --bundle --platform=node --outfile=dist-server/server-bundle.cjs --external:better-sqlite3 --external:node:sqlite",
    "electron": "electron .",
    "electron:admin": "electron electron/admin-main.cjs",
    "prepare:dotnet": "node scripts/prepare-dotnet-sdk.cjs",
    "package": "npm run prepare:dotnet && npm run clean:users && npm run build && npm run build:server && electron-builder",
    "package:admin": "npm run prepare:dotnet && npm run clean:admin && npm run build && npm run build:server && electron-builder --config electron-builder.admin.json"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.verity.app",
    "productName": "The Verity",
    "directories": {
      "output": "release/Users"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "KioskLockHook.exe"
        ]
      },
      {
        "from": "dist-server",
        "to": "dist-server",
        "filter": [
          "server-bundle.cjs"
        ]
      },
      {
        "from": "server",
        "to": ".",
        "filter": [
          "database.json",
          ".env"
        ]
      }
    ],
    "electronLanguages": [
      "en-US",
      "en"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}",
      "unpackDirName": "TheVerityApp"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "The Verity",
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    }
  },
  "dependencies": {
    "package": "^1.0.1"
  }
}