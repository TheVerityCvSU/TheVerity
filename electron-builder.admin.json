{
  "appId": "com.verity.admin.app",
  "productName": "The Verity Admin",
  "directories": {
    "output": "release/Admin"
  },
  "extraMetadata": {
    "main": "electron/admin-main.cjs"
  },
  "files": [
    "electron/**/*",
    "dist/**/*"
  ],
  "extraResources": [
    {
      "from": "dist-server",
      "to": "dist-server",
      "filter": [
        "server-bundle.cjs"
      ]
    },
    {
      "from": "server",
      "to": ".",
      "filter": [
        "database.json"
      ]
    }
  ],
  "electronLanguages": [
    "en-US",
    "en"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "electron/assets/icon-admin.ico"
  },
  "portable": {
    "artifactName": "${productName} Portable.${ext}",
    "unpackDirName": "TheVerityAdminApp"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "The Verity Admin Portal",
    "artifactName": "The Verity Admin Setup.${ext}",
    "installerIcon": "electron/assets/icon-admin.ico",
    "uninstallerIcon": "electron/assets/icon-admin.ico",
    "runAfterFinish": true,
    "include": "build/installer.nsh",
    "warningsAsErrors": false
  }
}
